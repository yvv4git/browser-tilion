# Image name and tag built from docker/tilion/Dockerfile.
TILION_IMAGE=browser-tilion
TILION_TAG=latest

# Base engine image (official stealth Chromium).
TILION_ENGINE_IMAGE=tilion/fortress:latest

# pip extras baked into the image: "mcp", "vision", or both.
TILION_EXTRAS=mcp,vision

# Host port the CDP endpoint is published on.
TILION_PORT=9222

# Tilion license key. Optional; activate later with `make activate`.
TILION_API_KEY=

# CDP URL other services use to reach the browser.
TILION_CDP_URL=http://tilion:9222

# LLM keys for the vision extra (agent). Optional.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Captcha solver key. Optional.
CAPTCHA_API_KEY=
